{
  "name": "immersive-cinematics-editor",
  "private": true,
  "version": "0.1.0",
  "description": "ImmersiveCinematics standalone Web editor",
  "author": "ImmersiveCinematics Team",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:build": "electron-builder --win",
    "e2e:system": "node --experimental-strip-types e2e-system/src/cli.ts",
    "e2e:system:list": "node --experimental-strip-types e2e-system/src/cli.ts list",
    "e2e:system:dry": "node --experimental-strip-types e2e-system/src/cli.ts dry-run",
    "e2e:system:run": "node --experimental-strip-types e2e-system/src/cli.ts run",
    "e2e:system:review": "node --experimental-strip-types e2e-system/src/cli.ts review",
    "e2e:system:smoke": "node --experimental-strip-types e2e-system/src/cli.ts smoke",
    "verify": "node --experimental-strip-types src/workbench/verify.ts",
    "verify:08": "node --experimental-strip-types src/workbench/verify-08.ts",
    "verify:12": "node --experimental-strip-types src/workbench/verify-12.ts",
    "verify:05": "node --experimental-strip-types src/workbench/verify-05.ts",
    "verify:06": "node --experimental-strip-types src/workbench/verify-06.ts",
    "verify:07": "node --experimental-strip-types src/workbench/verify-07.ts",
    "verify:09": "node --experimental-strip-types src/workbench/verify-09.ts",
    "verify:10": "node --experimental-strip-types src/workbench/verify-10.ts",
    "verify:11": "node --experimental-strip-types src/workbench/verify-11.ts",
    "verify:all": "node scripts/verify-all.mjs",
    "typecheck": "vue-tsc --noEmit",
    "fixtures:12": "node --experimental-strip-types src/workbench/emit-fixtures-12.ts",
    "release:local": "npm run build && npm run electron:build && node scripts/verify-release-assets.mjs && npm run e2e:system:smoke -- --exe release/win-unpacked/ImmersiveCinematicsEditor.exe --hold 3000"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vue-tsc": "3.3.14"
  }
}
