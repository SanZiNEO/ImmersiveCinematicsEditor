      {
        "type": "CAMERA",
        "clips": [
          {
            "start_time": 0,
            "duration": 2,
            "objects": {
              "fov": {
                "value": 70
              }
            }
          }
        ]
      }
    ]
  },
  "clips": [
    {
      "id": "clip_timing",
      "track": "CAMERA",
